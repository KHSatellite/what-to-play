# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env asla git'e girmez (.gitignore'da).

# PostgreSQL (docker-compose.yml ile aynı değerler)
DB_USER=neoynasam
DB_PASSWORD=change-me
DB_NAME=neoynasam
DB_HOST=localhost
DB_PORT=5432

# Dış servisler
RAWG_API_KEY=            # https://rawg.io/apidocs
STEAM_API_KEY=           # https://steamcommunity.com/dev/apikey

# JWT
SECRET_KEY=              # openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis / RabbitMQ (docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Hoş geldin e-postası (isteğe bağlı; boş bırakılırsa atlanır)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Hata izleme (isteğe bağlı)
SENTRY_DSN=
ENVIRONMENT=development
